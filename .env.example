COMPLIANCE_COMPLIANT_THRESHOLD_HOURS=2.0
COMPLIANCE_WARNING_THRESHOLD_HOURS=5.0
RESET_TOKEN_EXPIRY_MINUTES=15
RESET_MAX_ATTEMPTS=5
RESET_LOCKOUT_MINUTES=30
RESET_RATE_LIMIT_PER_HOUR=5
PASSWORD_MIN_LENGTH=8
MAX_LOGIN_ATTEMPTS=3
LOGIN_CHALLENGE_EXPIRY_MINUTES=5
UNLOCK_REQUEST_RATE_LIMIT_PER_HOUR=3
STORAGE_PROVIDER=local
LOCAL_UPLOAD_ROOT=uploads
ATTACHMENT_MAX_FILE_SIZE_BYTES=10485760
ATTACHMENT_MAX_FILES_PER_REQUEST=5

# Vite frontend - Microsoft Outlook / Graph (delegated SPA authentication)
VITE_AZURE_CLIENT_ID=f9e4bec0-f5e4-4861-a707-f96f4dded238
VITE_AZURE_TENANT_ID=9b00d396-39a3-4826-8fc9-a6fb51b0e9ea
VITE_AZURE_REDIRECT_URI=http://localhost:5173/auth/callback
VITE_USE_MOCK_ORGANIZATION=true

# Backend only - transactional email (DO NOT prefix with VITE_)
TRANSACTIONAL_EMAIL_ENABLED=false
EMAIL_PROVIDER=graph
TRANSACTIONAL_FROM_EMAIL=no-reply@reknew.ai
FRONTEND_BASE_URL=http://localhost:5173
# Generate once: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
EMAIL_PAYLOAD_ENCRYPTION_KEY=replace-with-a-fernet-key
ACTIVATION_TOKEN_EXPIRY_MINUTES=1440
EMAIL_MAX_ATTEMPTS=8
EMAIL_BASE_RETRY_SECONDS=30
EMAIL_MAX_RETRY_SECONDS=3600
EMAIL_LOCK_TIMEOUT_SECONDS=300
EMAIL_WORKER_POLL_SECONDS=5
GRAPH_HTTP_TIMEOUT_SECONDS=30

# Development credential. Store only in backend environment/secret store.
GRAPH_AUTH_MODE=client_secret
GRAPH_TENANT_ID=replace-with-directory-tenant-id
GRAPH_CLIENT_ID=replace-with-server-app-client-id
GRAPH_CLIENT_SECRET=replace-with-server-app-client-secret-value

# Production alternatives (leave blank in client_secret mode)
GRAPH_CERTIFICATE_PATH=
GRAPH_CERTIFICATE_PASSWORD=
GRAPH_MANAGED_IDENTITY_CLIENT_ID=
